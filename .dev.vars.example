# Copy this to `.dev.vars` for local `wrangler dev`. Never commit `.dev.vars`.
# In production, set these with `wrangler secret put <NAME>`.

DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_APP_ID=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
OPENROUTER_API_KEY=
# Optional; defaults to https://openrouter.ai/api/v1
# OPENROUTER_BASE_URL=
# Back-compat fallback:
# OPENAI_API_KEY=
# AI_GATEWAY_URL=
# Optional: Tavily search key (tvly-…) powering the shared web_search tool across
# all bots. Free tier ~1k searches/mo. If unset, bots fall back to their own knowledge.
# TAVILY_API_KEY=
# Optional: set to enable the finance bot in a separate channel
# DISCORD_FINANCE_CHANNEL_ID=
# Optional: finance Google Sheets working layer. GOOGLE_SERVICE_ACCOUNT_JSON is
# the entire service-account key file as one line (escape newlines in the PEM as
# \n, or paste the raw JSON); share the spreadsheet with the account's email.
# FINANCE_SHEET_ID is the long id from the sheet's URL. If unset, sheet sync
# no-ops and the finance bot stays chat-only.
# GOOGLE_SERVICE_ACCOUNT_JSON=
# FINANCE_SHEET_ID=
# Optional: set to enable the tasks bot in a separate channel
# DISCORD_TASKS_CHANNEL_ID=
# Optional: set to enable the workout bot in a separate channel
# DISCORD_WORKOUT_CHANNEL_ID=
