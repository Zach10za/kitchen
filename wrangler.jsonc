{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kitchen",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],

  // Durable Objects: one per bot. Each owns its own SQLite + alarm slot;
  // the runtime modules under src/runtime/ are what they share.
  "durable_objects": {
    "bindings": [
      {
        "name": "KITCHEN",
        "class_name": "KitchenDO"
      },
      {
        "name": "FINANCE",
        "class_name": "FinanceDO"
      }
    ]
  },

  // Migrations history. v1 created KitchenDO, v2 added GatewayDO (now removed),
  // v3 deletes GatewayDO (gateway connection lives on Fly.io now), v4 adds
  // FinanceDO for the finance bot.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["KitchenDO"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["GatewayDO"]
    },
    {
      "tag": "v3",
      "deleted_classes": ["GatewayDO"]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["FinanceDO"]
    }
  ],

  // Workflows for long-running multi-step operations (e.g. /approve).
  // Each step.do(...) gets its own request lifetime + automatic retries.
  "workflows": [
    {
      "name": "approve-plan",
      "binding": "APPROVE_WORKFLOW",
      "class_name": "ApproveWorkflow"
    },
    {
      "name": "steer",
      "binding": "STEER_WORKFLOW",
      "class_name": "SteerWorkflow"
    },
    {
      "name": "finance-steer",
      "binding": "FINANCE_STEER_WORKFLOW",
      "class_name": "FinanceSteerWorkflow"
    }
  ],

  // Hourly cron keeps KitchenDO alarms armed and dispatches due reminders.
  "triggers": {
    "crons": ["0 * * * *"]
  },

  // AI Gateway binding (set up in Cloudflare dashboard at:
  //   AI > AI Gateway > create gateway "kitchen")
  "ai": {
    "binding": "AI"
  },

  // Workers Logs — populates the dashboard's Observability tab with every
  // console.* call and uncaught exception. head_sampling_rate=1 keeps 100%
  // of requests; lower it (e.g. 0.1) if volume gets noisy. Free tier retains
  // logs for 7 days.
  //
  // Workers Traces — distributed tracing of every request through fetch /
  // alarm / scheduled handlers, with spans for DO calls, sub-fetches, and
  // Workflow steps. Currently enabled separately; Cloudflare plans to fold
  // this into observability.enabled in a future compatibility date.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },

  // Public env (non-secret). Secrets go via `wrangler secret put`.
  "vars": {
    // Planner / steering model — strongest reasoning we use.
    "OPENAI_MODEL": "gpt-5-mini",
    // Pure structured-output extraction (pantry parse, recipe materialize).
    // Cheap + fast; no creativity needed.
    "OPENAI_MODEL_EXTRACT": "gpt-5-nano",
    // Cheap, fast model for one-shot title generation in error triage.
    "OPENAI_MODEL_FAST": "gpt-5-nano",
    "DRAFT_DAY": "fri",
    "DRAFT_HOUR_LOCAL": "18",
    "TIMEZONE": "America/Los_Angeles",
    "GITHUB_REPO": "Zach10za/kitchen",
    // Per-channel /relay/message rate limit, in messages per rolling hour.
    "RELAY_RATE_LIMIT_PER_HOUR": "30"
  }

  // Secrets to set with `wrangler secret put`:
  //   DISCORD_PUBLIC_KEY         — for verifying interaction signatures
  //   DISCORD_BOT_TOKEN          — for posting messages via REST
  //   DISCORD_APP_ID             — for slash command registration
  //   DISCORD_GUILD_ID           — your server ID (scopes commands to your server)
  //   DISCORD_CHANNEL_ID         — channel the kitchen bot posts proactive drafts to
  //   DISCORD_FINANCE_CHANNEL_ID — channel the finance bot posts to
  //   OPENAI_API_KEY             — your OpenAI key
  //   AI_GATEWAY_URL             — e.g. https://gateway.ai.cloudflare.com/v1/<acct>/kitchen/openai
  //   RELAY_SECRET               — shared secret with the Fly.io gateway-relay
  //   ADMIN_TOKEN                — bearer token for /admin/* endpoints
  //   GITHUB_TOKEN               — fine-grained PAT with Issues:write on this repo
  //                                (used by error-triage to file auto-fix issues)
  //   SIMPLEFIN_ACCESS_URL       — long-lived SimpleFin Bridge access URL with embedded
  //                                Basic-auth creds. Run `bun run scripts/simplefin-claim.ts`
  //                                once with a setup token to mint this.
}
