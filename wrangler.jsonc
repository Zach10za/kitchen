{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kitchen",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],

  // Durable Objects: one per bot. Each owns its own SQLite + alarm slot;
  // the runtime modules under src/runtime/ are what they share.
  "durable_objects": {
    "bindings": [
      {
        "name": "KITCHEN",
        "class_name": "KitchenDO",
      },
      {
        "name": "FINANCE",
        "class_name": "FinanceDO",
      },
      {
        "name": "TASKS",
        "class_name": "TasksDO",
      },
      {
        "name": "WORKOUT",
        "class_name": "WorkoutDO",
      },
    ],
  },

  // Migrations history. v1 created KitchenDO, v2 added GatewayDO (now removed),
  // v3 deletes GatewayDO (gateway connection lives on Fly.io now), v4 adds
  // FinanceDO for the finance bot, v5 adds TasksDO for the tasks bot, v6 adds
  // WorkoutDO for the workout bot.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["KitchenDO"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["GatewayDO"],
    },
    {
      "tag": "v3",
      "deleted_classes": ["GatewayDO"],
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["FinanceDO"],
    },
    {
      "tag": "v5",
      "new_sqlite_classes": ["TasksDO"],
    },
    {
      "tag": "v6",
      "new_sqlite_classes": ["WorkoutDO"],
    },
  ],

  // Workflows for long-running multi-step operations.
  // Each step.do(...) gets its own request lifetime + automatic retries.
  //
  // AgentChatWorkflow replaces the four legacy per-bot *SteerWorkflow classes.
  // It's parameterized by `botId` in workflow params so one class serves every
  // bot (kitchen/finance/tasks/workout). Adding a new agent bot no longer
  // requires a new workflow binding here.
  "workflows": [
    {
      "name": "agent-chat",
      "binding": "AGENT_CHAT_WORKFLOW",
      "class_name": "AgentChatWorkflow",
    },
  ],

  // Hourly cron keeps KitchenDO's daily alarm armed and dispatches due reminders.
  "triggers": {
    "crons": ["0 * * * *"],
  },

  // AI Gateway binding (set up in Cloudflare dashboard at:
  //   AI > AI Gateway > create gateway "kitchen")
  "ai": {
    "binding": "AI",
  },

  // Workers Logs — populates the dashboard's Observability tab with every
  // console.* call and uncaught exception. head_sampling_rate=1 keeps 100%
  // of requests; lower it (e.g. 0.1) if volume gets noisy. Free tier retains
  // logs for 7 days.
  //
  // Workers Traces — distributed tracing of every request through fetch /
  // alarm / scheduled handlers, with spans for DO calls, sub-fetches, and
  // Workflow steps. Currently enabled separately; Cloudflare plans to fold
  // this into observability.enabled in a future compatibility date.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
  },

  // Public env (non-secret). Secrets go via `wrangler secret put`.
  "vars": {
    // Planner / steering model — strongest reasoning we use.
    "OPENAI_MODEL": "gpt-5.4-mini",
    // Pure structured-output extraction (pantry parse, recipe materialize).
    // Cheap + fast; no creativity needed.
    "OPENAI_MODEL_EXTRACT": "gpt-5.4-nano",
    // Cheap, fast model for one-shot title generation in error triage.
    "OPENAI_MODEL_FAST": "gpt-5.4-nano",
    // Local hour the daily dinner-suggestion ping fires (24h). Noon by default.
    "SUGGEST_HOUR_LOCAL": "12",
    // Local dinner hour defrost reminders are anchored to.
    "DINNER_HOUR_LOCAL": "18",
    // Local hour the workout bot's daily check-in fires (Monday recap,
    // inactivity nudges, hiatus welcome-back). Quiet when there's nothing to say.
    "WORKOUT_CHECKIN_HOUR_LOCAL": "9",
    "TIMEZONE": "America/Los_Angeles",
    "GITHUB_REPO": "Zach10za/kitchen",
    // Per-channel /relay/message rate limit, in messages per rolling hour.
    "RELAY_RATE_LIMIT_PER_HOUR": "30",
    // OpenAI pricing — update when OpenAI changes prices, no code deploy needed.
    // Defaults reflect gpt-5.4-mini per OpenAI's published pricing as of 2026-05;
    // cached input is 90% off standard. Built-in tool prices are flat per-call.
    // Override per-environment if you switch to a different model tier.
    "PRICE_INPUT_PER_M": "0.75",
    "PRICE_CACHED_INPUT_PER_M": "0.075",
    "PRICE_OUTPUT_PER_M": "4.50",
    "PRICE_WEB_SEARCH_PER_CALL": "0.025",
    "PRICE_CODE_INTERPRETER_PER_CALL": "0.03",
  },

  // Secrets to set with `wrangler secret put`:
  //   DISCORD_PUBLIC_KEY         — for verifying interaction signatures
  //   DISCORD_BOT_TOKEN          — for posting messages via REST
  //   DISCORD_APP_ID             — for slash command registration
  //   DISCORD_GUILD_ID           — your server ID (scopes commands to your server)
  //   DISCORD_CHANNEL_ID         — channel the kitchen bot posts daily dinner suggestions to
  //   DISCORD_FINANCE_CHANNEL_ID — channel the finance bot posts to
  //   DISCORD_TASKS_CHANNEL_ID   — channel the tasks bot posts to
  //   DISCORD_WORKOUT_CHANNEL_ID — channel the workout bot posts to
  //   OPENAI_API_KEY             — your OpenAI key
  //   AI_GATEWAY_URL             — e.g. https://gateway.ai.cloudflare.com/v1/<acct>/kitchen/openai
  //   RELAY_SECRET               — shared secret with the Fly.io gateway-relay
  //   ADMIN_TOKEN                — bearer token for /admin/* endpoints
  //   GITHUB_TOKEN               — fine-grained PAT with Issues:write on this repo
  //                                (used by error-triage to file auto-fix issues)
  //   TAVILY_API_KEY             — Tavily search key (tvly-…) powering the shared
  //                                web_search tool across all bots. Optional; free tier ~1k/mo.
  //   SIMPLEFIN_ACCESS_URL       — long-lived SimpleFin Bridge access URL with embedded
  //                                Basic-auth creds. Run `bun run scripts/simplefin-claim.ts`
  //                                once with a setup token to mint this.
  //   GOOGLE_SERVICE_ACCOUNT_JSON — full service-account key JSON for the finance Google
  //                                Sheets working layer. Create a service account in Google
  //                                Cloud, enable the Sheets API, and share the spreadsheet
  //                                with the account's email. Optional; sheet sync no-ops if unset.
  //   FINANCE_SHEET_ID           — spreadsheet id (the long id in the sheet's URL) the finance
  //                                bot maintains a `Transactions` tab in. Optional.
}
